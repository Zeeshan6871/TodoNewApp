# MongoDB Atlas Connection String
# Get this from MongoDB Atlas: Database -> Connect -> Drivers (Node.js)
# Replace <username>, <password>, and <cluster> with your Atlas cluster details
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/todo_app?retryWrites=true&w=majority

# Target Database Name (Optional, defaults to todo_app)
MONGODB_DB=todo_app

